{
  "manifest_version": 3,
  "name": "AI Token Tracker for Claude",
  "version": "4.0.0",
  "description": "See your claude.ai usage limits, chat length and how many messages you have left, right inside claude.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude usage"
  },
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared.js",
        "tokenizer.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage@ai-token-tracker",
      "strict_min_version": "128.0"
    }
  }
}
